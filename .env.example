# Copy to .env (ignored by Git) and point at the folder holding csi-vial-fill-dataset/ and csi_digital_twin_v1/.
# Leave unset to use <repo>/external. Use forward slashes or a quoted Windows path.
FLUIDMIX_DATA=
# Generated files (labels, colors, trained outputs). Default: <repo>/outputs. Keep separate from the data root.
FLUIDMIX_OUTPUTS=
