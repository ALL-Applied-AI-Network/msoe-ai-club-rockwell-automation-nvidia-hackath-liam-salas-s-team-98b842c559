#!/usr/bin/env python3
"""Repository-native FluidMix runner command."""

from pathlib import Path
import sys

ROOT = Path(__file__).resolve().parent
sys.path.insert(0, str(ROOT / "src"))

from fluidmix.pipeline.service.http import main


def cli(argv: list[str] | None = None) -> int:
    arguments = list(sys.argv[1:] if argv is None else argv)
    if not arguments or arguments.pop(0) != "serve":
        raise SystemExit("usage: runner serve [--host HOST] [--port PORT]")
    if "--adapter-factory" not in arguments:
        arguments.extend([
            "--adapter-factory",
            "fluidmix.pipeline.service.production_factory:factory",
        ])
    return main(arguments)


if __name__ == "__main__":
    raise SystemExit(cli())
