# Mixture Of Experts chart style (light theme). Use: plt.style.use("docs/presentation/moe.mplstyle")
# Colour meaning is fixed: tank-blue = our method, baseline grey = every baseline,
# tank-orange = carryover / old recipe, flag red = a miss or failure (small, with a word).
# Values come from docs/presentation/tokens.json; change both together.

font.family: sans-serif
font.sans-serif: IBM Plex Sans, DejaVu Sans, Arial
font.size: 14
text.color: 1b2430

figure.facecolor: f6f5f1
figure.figsize: 12, 6.75
figure.dpi: 150
savefig.facecolor: f6f5f1
savefig.bbox: tight

axes.facecolor: ffffff
axes.edgecolor: d6d3cb
axes.labelcolor: 1b2430
axes.titlesize: 18
axes.titleweight: semibold
axes.titlelocation: left
axes.labelsize: 14
axes.spines.top: False
axes.spines.right: False
axes.grid: True
axes.grid.axis: y
axes.axisbelow: True
# Order: tank-blue (ours), baseline grey, tank-orange, flag red
axes.prop_cycle: cycler('color', ['1d5ca3', '646a76', 'b8520b', 'a3121f'])

grid.color: d6d3cb
grid.linewidth: 0.8

xtick.color: 535e6c
ytick.color: 535e6c
xtick.labelsize: 12
ytick.labelsize: 12

legend.frameon: False
legend.fontsize: 12

lines.linewidth: 2.5
patch.edgecolor: none
