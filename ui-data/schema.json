{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://fluidmix.example/ui-data/schema.json",
  "title": "Fluid Mixing Phase 1 Operator Demo Data",
  "description": "Complete synthetic twin wire contract for the static operator demo.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "dataset_id", "label", "data_origin", "run", "recipes", "history", "top_down", "vials", "evidence", "wp6"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "dataset_id": { "$ref": "#/definitions/nonEmptyString" },
    "label": { "type": "string", "pattern": "Synthetic twin data" },
    "data_origin": { "const": "synthetic_twin" },
    "run": { "$ref": "#/definitions/run" },
    "recipes": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/recipe" }
    },
    "history": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/history" }
    },
    "top_down": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "asset", "observations"],
      "properties": {
        "state": { "enum": ["waiting", "feed"] },
        "asset": { "$ref": "#/definitions/assetReference" },
        "observations": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/topDownObservation" }
        }
      }
    },
    "vials": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/vial" }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/evidence" }
    },
    "wp6": { "$ref": "#/definitions/wp6" }
  },
  "definitions": {
    "nonEmptyString": { "type": "string", "minLength": 1 },
    "localAssetPath": { "type": "string", "pattern": "^/assets/" },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "source_id", "note"],
      "properties": {
        "kind": { "enum": ["measured", "documented", "inferred"] },
        "source_id": { "$ref": "#/definitions/nonEmptyString" },
        "note": { "$ref": "#/definitions/nonEmptyString" }
      }
    },
    "position": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "provenance"],
      "properties": {
        "x": { "type": "number", "minimum": 0, "maximum": 1 },
        "y": { "type": "number", "minimum": 0, "maximum": 1 },
        "provenance": { "$ref": "#/definitions/provenance" }
      }
    },
    "bbox": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "width", "height", "provenance"],
      "properties": {
        "x": { "type": "number", "minimum": 0, "maximum": 1 },
        "y": { "type": "number", "minimum": 0, "maximum": 1 },
        "width": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
        "height": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
        "provenance": { "$ref": "#/definitions/provenance" }
      }
    },
    "topDownObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["vial_id", "decision_id", "position", "bbox"],
      "properties": {
        "vial_id": { "$ref": "#/definitions/nonEmptyString" },
        "decision_id": { "$ref": "#/definitions/nonEmptyString" },
        "position": { "$ref": "#/definitions/position" },
        "bbox": { "$ref": "#/definitions/bbox" }
      }
    },
    "numberWithProvenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "provenance"],
      "properties": {
        "value": { "type": "number", "minimum": 0 },
        "provenance": { "$ref": "#/definitions/provenance" }
      }
    },
    "rgb": {
      "type": "object",
      "additionalProperties": false,
      "required": ["r", "g", "b", "provenance"],
      "properties": {
        "r": { "type": "integer", "minimum": 0, "maximum": 255 },
        "g": { "type": "integer", "minimum": 0, "maximum": 255 },
        "b": { "type": "integer", "minimum": 0, "maximum": 255 },
        "provenance": { "$ref": "#/definitions/provenance" }
      }
    },
    "lab": {
      "type": "object",
      "additionalProperties": false,
      "required": ["l", "a", "b", "provenance"],
      "properties": {
        "l": { "type": "number", "minimum": 0, "maximum": 100 },
        "a": { "type": "number", "minimum": -128, "maximum": 127 },
        "b": { "type": "number", "minimum": -128, "maximum": 127 },
        "provenance": { "$ref": "#/definitions/provenance" }
      }
    },
    "assetReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["asset_id", "src", "provenance"],
      "properties": {
        "asset_id": { "$ref": "#/definitions/nonEmptyString" },
        "src": { "$ref": "#/definitions/localAssetPath" },
        "provenance": { "$ref": "#/definitions/provenance" }
      }
    },
    "videoAsset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["asset_id", "src", "media_type", "duration_seconds", "provenance"],
      "properties": {
        "asset_id": { "$ref": "#/definitions/nonEmptyString" },
        "src": { "$ref": "#/definitions/localAssetPath" },
        "media_type": { "const": "video/mp4" },
        "duration_seconds": { "$ref": "#/definitions/numberWithProvenance" },
        "provenance": { "$ref": "#/definitions/provenance" }
      }
    },
    "cue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["vial_id", "start_seconds", "end_seconds", "provenance"],
      "properties": {
        "vial_id": { "$ref": "#/definitions/nonEmptyString" },
        "start_seconds": { "type": "number", "minimum": 0 },
        "end_seconds": { "type": "number", "exclusiveMinimum": 0 },
        "provenance": { "$ref": "#/definitions/provenance" }
      }
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": ["run_id", "title", "video", "cue_times"],
      "properties": {
        "run_id": { "$ref": "#/definitions/nonEmptyString" },
        "title": { "$ref": "#/definitions/nonEmptyString" },
        "video": { "$ref": "#/definitions/videoAsset" },
        "cue_times": {
          "type": "array",
          "minItems": 9,
          "maxItems": 9,
          "items": { "$ref": "#/definitions/cue" }
        }
      }
    },
    "recipe": {
      "type": "object",
      "additionalProperties": false,
      "required": ["recipe_id", "label", "rgb"],
      "properties": {
        "recipe_id": { "$ref": "#/definitions/nonEmptyString" },
        "label": { "$ref": "#/definitions/nonEmptyString" },
        "rgb": { "$ref": "#/definitions/rgb" }
      }
    },
    "explanation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "text", "evidence_refs"],
      "properties": {
        "source": { "enum": ["deterministic_template", "cosmos_reason2"] },
        "text": { "$ref": "#/definitions/nonEmptyString" },
        "evidence_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/definitions/nonEmptyString" }
        }
      }
    },
    "history": {
      "type": "object",
      "additionalProperties": false,
      "required": ["history_id", "recipe_id", "run_id", "vial_id", "time_seconds", "decision", "explanation", "provenance"],
      "properties": {
        "history_id": { "$ref": "#/definitions/nonEmptyString" },
        "recipe_id": { "$ref": "#/definitions/nonEmptyString" },
        "run_id": { "$ref": "#/definitions/nonEmptyString" },
        "vial_id": { "$ref": "#/definitions/nonEmptyString" },
        "time_seconds": { "$ref": "#/definitions/numberWithProvenance" },
        "decision": { "enum": ["keep", "discard", "insufficient_evidence"] },
        "explanation": { "$ref": "#/definitions/explanation" },
        "provenance": { "$ref": "#/definitions/provenance" }
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["record_id", "outcome", "delta_e", "threshold", "limit_codes", "evidence_refs", "explanation"],
      "properties": {
        "record_id": { "$ref": "#/definitions/nonEmptyString" },
        "outcome": { "enum": ["keep", "discard", "insufficient_evidence"] },
        "delta_e": { "$ref": "#/definitions/numberWithProvenance" },
        "threshold": { "$ref": "#/definitions/numberWithProvenance" },
        "limit_codes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["within_delta_e_limit", "exceeds_delta_e_limit", "measurement_unavailable", "mask_unavailable"] }
        },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/definitions/nonEmptyString" }
        },
        "explanation": { "$ref": "#/definitions/explanation" }
      }
    },
    "vial": {
      "type": "object",
      "additionalProperties": false,
      "required": ["slot", "vial_id", "recipe_id", "rgb_frame", "predicted_mask", "target_lab", "reference_lab", "decision", "history_refs"],
      "properties": {
        "slot": { "type": "integer", "minimum": 1, "maximum": 9 },
        "vial_id": { "$ref": "#/definitions/nonEmptyString" },
        "recipe_id": { "$ref": "#/definitions/nonEmptyString" },
        "rgb_frame": { "$ref": "#/definitions/assetReference" },
        "predicted_mask": { "$ref": "#/definitions/assetReference" },
        "target_lab": { "$ref": "#/definitions/lab" },
        "reference_lab": { "$ref": "#/definitions/lab" },
        "decision": { "$ref": "#/definitions/decision" },
        "history_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/definitions/nonEmptyString" }
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence_id", "vial_id", "target", "label", "provenance"],
      "properties": {
        "evidence_id": { "$ref": "#/definitions/nonEmptyString" },
        "vial_id": { "$ref": "#/definitions/nonEmptyString" },
        "target": { "enum": ["recipe_rgb", "rgb_frame", "predicted_mask", "target_lab", "reference_lab", "delta_e", "threshold"] },
        "label": { "$ref": "#/definitions/nonEmptyString" },
        "provenance": { "$ref": "#/definitions/provenance" }
      }
    },
    "wp6Row": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "label", "passed", "total", "method_note", "failure_note", "provenance"],
      "properties": {
        "method": { "enum": ["template", "qwen3_vl", "anomalythink_free_form", "cosmos_strict_parse"] },
        "label": { "$ref": "#/definitions/nonEmptyString" },
        "passed": { "type": "integer", "minimum": 0 },
        "total": { "const": 16 },
        "method_note": { "$ref": "#/definitions/nonEmptyString" },
        "failure_note": { "type": ["string", "null"] },
        "provenance": { "$ref": "#/definitions/provenance" }
      }
    },
    "wp6": {
      "type": "object",
      "additionalProperties": false,
      "required": ["disclaimer", "rows", "inn67"],
      "properties": {
        "disclaimer": { "const": "limited all-abstention benchmark, no accuracy claim" },
        "rows": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": { "$ref": "#/definitions/wp6Row" }
        },
        "inn67": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "label", "note"],
          "properties": {
            "status": { "const": "placeholder" },
            "label": { "const": "INN-67 placeholder" },
            "note": { "$ref": "#/definitions/nonEmptyString" }
          }
        }
      }
    }
  }
}
