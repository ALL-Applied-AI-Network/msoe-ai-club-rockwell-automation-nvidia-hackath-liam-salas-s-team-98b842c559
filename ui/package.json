{
  "name": "fluidmix-operator-demo",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "test": "vitest run --exclude 'e2e/**'",
    "test:unit": "vitest run --exclude 'e2e/**'",
    "test:component": "vitest run --exclude 'e2e/**'",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "e2e": "playwright test --project=test-only",
    "e2e:screens": "playwright test --config=playwright.screens.config.ts",
    "e2e:install": "playwright install chromium"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "24.10.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "ffmpeg-static": "5.3.0",
    "jsdom": "26.1.0",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
